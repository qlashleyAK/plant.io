# plant.io environment — copy to .env and fill in. .env is gitignored.
# Never commit real values. The compose file fails fast (:?set in .env) without these.

# --- required ---
# Admin login for the API
ACCESS_KEY=change-me
# Session signing secret (any long random string)
SESSION_SECRET=change-me
# Web-push VAPID keypair — generate fresh: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
# MinIO / S3 credentials for the media store
MINIO_ROOT_PASSWORD=change-me
S3_SECRET_KEY=change-me

# --- optional (defaults shown) ---
# S3_ACCESS_KEY=plantio
# MINIO_ROOT_USER=plantio
# OLLAMA_MODEL=gemma3:27b-abliterated-vision
# OLLAMA_TEXT_MODEL=gpt-oss:20b-heretic-ara-v3
# OLLAMA_HOST=http://192.168.40.199:11434
