    {
        "id": "pio_command_tab",
        "type": "tab",
        "label": "plant.io Commands",
        "disabled": false,
        "info": "Receives actuator commands from the UI via MQTT and routes them to Phidget digital outputs.",
        "env": []
    },
    {
        "id": "pio_command_mqtt_in",
        "type": "mqtt in",
        "z": "pio_command_tab",
        "name": "Command Listener",
        "topic": "airoponic/command/#",
        "qos": "1",
        "datatype": "utf8",
        "broker": "pio_mqtt_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 180,
        "y": 120,
        "wires": [["pio_command_router"]]
    },
    {
        "id": "pio_command_router",
        "type": "function",
        "z": "pio_command_tab",
        "name": "Route Command",
        "func": "const topic = msg.topic;\nconst parts = topic.split('/');\nconst actuatorId = parts[2];\nconst state = String(msg.payload).toUpperCase() === 'ON';\n\nmsg.topic = 'setState';\nmsg.payload = { state: state };\nmsg.actuatorId = actuatorId;\n\nconst teleTopic = `airoponic/telemetry/${actuatorId}/state`;\nconst teleMsg = { topic: teleTopic, payload: state ? 'ON' : 'OFF' };\n\nswitch(actuatorId) {\n  case 'mister1':     return [msg, null, null, null, null, teleMsg];\n  case 'mister2':     return [null, msg, null, null, null, teleMsg];\n  case 'small_air_pump': return [null, null, msg, null, null, teleMsg];\n  case 'large_air_pump': return [null, null, null, msg, null, teleMsg];\n  case 'recovery_pump':  return [null, null, null, null, msg, teleMsg];\n  default:\n    node.warn('Unknown actuator: ' + actuatorId);\n    return [null, null, null, null, null, null];\n}",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 120,
        "wires": [
            ["pio_cmd_mister1"],
            ["pio_cmd_mister2"],
            ["pio_cmd_small_air"],
            ["pio_cmd_large_air"],
            ["pio_cmd_recovery"],
            ["pio_cmd_telemetry_out"]
        ]
    },
