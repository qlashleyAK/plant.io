    {
        "id": "pio_discovery_tab",
        "type": "tab",
        "label": "plant.io Discovery",
        "disabled": false,
        "info": "Auto-discovery for plant.io dashboard. Publishes sensor/actuator metadata on startup.",
        "env": []
    },
    {
        "id": "pio_discovery_inject",
        "type": "inject",
        "z": "pio_discovery_tab",
        "name": "On startup + every 5min",
        "props": [{ "p": "payload" }, { "p": "topic", "vt": "str" }],
        "repeat": "300",
        "crontab": "",
        "once": true,
        "onceDelay": "2",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 200,
        "y": 100,
        "wires": [["pio_discovery_func"]]
    },
    {
        "id": "pio_discovery_func",
        "type": "function",
        "z": "pio_discovery_tab",
        "name": "Publish discovery messages",
        "func": "const sensors = [\n  {\n    id: 'light_sensor',\n    name: 'Tent Light',\n    type: 'sensor',\n    data_type: 'number',\n    unit: 'lux',\n    icon: 'sun',\n    topic: 'airoponic/telemetry/light_sensor/level_lux',\n    gauge: { min: 0, max: 18000, segments: [{from:0,color:'#22c55e'},{from:6000,color:'#eab308'},{from:10000,color:'#ef4444'}] }\n  },\n  {\n    id: 'temp_sensor',\n    name: 'Tent Temperature',\n    type: 'sensor',\n    data_type: 'number',\n    unit: '°C',\n    icon: 'thermometer',\n    topic: 'airoponic/telemetry/temp_sensor/temp_c',\n    gauge: { min: 0, max: 40, segments: [{from:0,color:'#3b82f6'},{from:20,color:'#22c55e'},{from:25,color:'#eab308'},{from:30,color:'#ef4444'}] }\n  },\n  {\n    id: 'hygro_sensor',\n    name: 'Tent Humidity',\n    type: 'sensor',\n    data_type: 'number',\n    unit: '%',\n    icon: 'droplets',\n    topic: 'airoponic/telemetry/hygro_sensor/hum_percent',\n    gauge: { min: 0, max: 100, segments: [{from:0,color:'#22c55e'},{from:80,color:'#eab308'},{from:95,color:'#ef4444'}] }\n  },\n  {\n    id: 'rtd_sensor',\n    name: 'Supply Tank Temp',\n    type: 'sensor',\n    data_type: 'number',\n    unit: '°C',\n    icon: 'thermometer',\n    topic: 'airoponic/telemetry/rtd_sensor/temp_c',\n    gauge: { min: 0, max: 40, segments: [{from:0,color:'#3b82f6'},{from:18,color:'#22c55e'},{from:24,color:'#eab308'},{from:28,color:'#ef4444'}] }\n  },\n  {\n    id: 'ph_sensor',\n    name: 'Supply Tank pH',\n    type: 'sensor',\n    data_type: 'number',\n    unit: 'pH',\n    icon: 'flask-conical',\n    topic: 'airoponic/telemetry/ph_sensor/ph',\n    gauge: { min: 4, max: 10, segments: [{from:4,color:'#ef4444'},{from:5.5,color:'#eab308'},{from:6,color:'#22c55e'},{from:7.5,color:'#eab308'},{from:8,color:'#ef4444'}] }\n  },\n  {\n    id: 'circuit_pressure',\n    name: 'Circuit Pressure',\n    type: 'sensor',\n    data_type: 'number',\n    unit: 'psi',\n    icon: 'gauge',\n    topic: 'airoponic/telemetry/circuit_pressure_sensor/pressure_psi',\n    gauge: { min: 0, max: 100, segments: [{from:0,color:'#22c55e'},{from:65,color:'#eab308'},{from:75,color:'#ef4444'}] }\n  },\n  {\n    id: 'supply_tank_level',\n    name: 'Supply Tank Level',\n    type: 'sensor',\n    data_type: 'number',\n    unit: 'mm',\n    icon: 'waves',\n    topic: 'airoponic/telemetry/supply_tank/level_l',\n    gauge: { min: 0, max: 1000, segments: [{from:0,color:'#ef4444'},{from:200,color:'#eab308'},{from:400,color:'#22c55e'}] }\n  },\n  {\n    id: 'tank_return_flow',\n    name: 'Tank Return Flow',\n    type: 'sensor',\n    data_type: 'number',\n    unit: 'mL/min',\n    icon: 'arrow-down-to-line',\n    topic: 'airoponic/telemetry/tank_return/flow_ml',\n    gauge: { min: 0, max: 70, segments: [{from:0,color:'#22c55e'},{from:40,color:'#eab308'},{from:60,color:'#ef4444'}] }\n  },\n  {\n    id: 'mister1',\n    name: 'Mister #1',\n    type: 'actuator',\n    data_type: 'binary',\n    unit: '',\n    icon: 'spray-can',\n    topic: 'airoponic/telemetry/mister1/state',\n    command_topic: 'airoponic/command/mister1/set'\n  },\n  {\n    id: 'mister2',\n    name: 'Mister #2',\n    type: 'actuator',\n    data_type: 'binary',\n    unit: '',\n    icon: 'spray-can',\n    topic: 'airoponic/telemetry/mister2/state',\n    command_topic: 'airoponic/command/mister2/set'\n  },\n  {\n    id: 'small_air_pump',\n    name: 'Small Aeration Pump',\n    type: 'actuator',\n    data_type: 'binary',\n    unit: '',\n    icon: 'wind',\n    topic: 'airoponic/telemetry/small_air_pump/state',\n    command_topic: 'airoponic/command/small_air_pump/set'\n  },\n  {\n    id: 'large_air_pump',\n    name: 'Big Aeration Pump',\n    type: 'actuator',\n    data_type: 'binary',\n    unit: '',\n    icon: 'wind',\n    topic: 'airoponic/telemetry/large_air_pump/state',\n    command_topic: 'airoponic/command/large_air_pump/set'\n  },\n  {\n    id: 'recovery_pump',\n    name: 'Recovery Pump',\n    type: 'actuator',\n    data_type: 'binary',\n    unit: '',\n    icon: 'rotate-ccw',\n    topic: 'airoponic/telemetry/recovery_pump/state',\n    command_topic: 'airoponic/command/recovery_pump/set'\n  }\n];\n\nfor (const s of sensors) {\n  node.send({\n    topic: `pio/discovery/${s.id}`,\n    payload: JSON.stringify(s),\n    retain: true\n  });\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 100,
        "wires": [["pio_discovery_mqtt"]]
    },
